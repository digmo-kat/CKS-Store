<section class="home-new-product-sec {{ section.settings.css_class }}">
  <div class="section">
    <div class="contianer">
        <div class="home-new-product-main-head">
            <h2 class="f-weight-800 secondary-heading c-light-back f-italc t-capitalize">{{ section.settings.main-head }}</h2>
        </div>
        <div class="home-new-product-wrapper">
          {% if section.settings.show_banner %}
            <div class="home-new-product-banner" style="background-image:url({{ section.settings.banner_img | image_url: width: 300 }})">
              <a href="{{ section.settings.banner_link }}">
                <div class="home-new-product-content-wrpaer">
                  <h5 class="primary-paragraph c-light-back">{{ section.settings.banner_subheading }}</h5>
                  <h4 class="quaternary-heading f-weight-700 c-light-back">{{ section.settings.banner_heading }}</h4>
                  <p class="secondary-paragraph c-light-back">{{ section.settings.banner_description }}</p>
                </div>
                <img src="{{ section.settings.banner_img | image_url: width: 300 }}" alt="" width="300" height="100%">
                
              </a>
            </div>
          {% endif %}
          <div class="best-seller">
            {% assign collection = collections[section.settings.select-coll] %}
            {% for product in collection.products limit: 12 %}
              <div class="home-new-product-main-block">
                  <div class="home-new-product-img">
                      <a href="{{ product.url }}">
                            <img src="{{ product.featured_image | image_url: width: 300 }}" alt="" width="300" height="100%">
                      </a>
                  </div>
                  <div class="home-new-product-content-wrpaer">
                      <div class="home-new-product-vendor">
                        <p class="c-light-black">{{ product.collections.first.title }}</p>
                      </div>
                      <a href="{{ product.url }}" class="home-product-name">
                          <h4 class="quaternary-heading f-weight-700 c-light-back">{{ product.title | truncatewords: 6 }}</h4>
                      </a>
                      <div class="home-new-product-price">
                          <h3 class="tertiary-heading">{{ product.price | money }}</h3>
                      </div>
                      {% comment %} <div class="home-new-product-btn">
                        {% if product.variants.size > 1 %}
                          <a href="{{ product.url }}" class="c-blue f-weight-600 primary-paragraph">
                            View Product
                            <i class="fa-solid fa-arrow-right-long"></i>
                          </a>
                        {% else %}
                          <form method="post" action="/cart/add">
                            <input type="hidden" name="return_to" value="back">
                            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                            <button type="submit" class="c-blue f-weight-600 primary-paragraph">
                              Add to Cart
                              <i class="fa-solid fa-arrow-right-long"></i>
                            </button>
                          </form>
                        {% endif %}
                      </div> {% endcomment %}

                  </div>
              </div>
            {% endfor %}
          </div>
        </div>
    </div>
</div>
</section>

{% schema %}
  {
    "name": "Best Sellers",
    "settings": [
      {
        "type": "text",
        "label": "Main Heading",
        "id": "main-head"
      },
      {
        "type": "collection",
        "label": "Select Collection",
        "id": "select-coll"
      },
      {
        "type": "text",
        "id": "css_class",
        "label": "CSS Class"
      },
      {
        "type": "header",
        "content": "Banner Setting"
      },
      {
         "type": "checkbox",
         "id": "show_banner",
         "label": "Show Banner"
      },
      {
        "type": "image_picker",
        "id": "banner_img",
        "label": "Banner Image"
      },
      {
        "type": "text",
        "id": "banner_heading",
        "label": "Banner Heading"
      },
      {
        "type": "text",
        "id": "banner_subheading",
        "label": "Banner Sub Heading"
      },
      {
        "type": "textarea",
        "id": "banner_description",
        "label": "Banner Description"
      },
      {
        "type": "url",
        "id": "banner_link",
        "label": "Banner Link"
      }
    ],
    "presets": [
      {
        "name": "Best Sellers"
      }
    ]
  }
{% endschema %}