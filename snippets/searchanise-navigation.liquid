{% if template == 'collection' %}

  <section class="section {% if section.settings.wide_display == true %}is-width-wide has-no-side-gutter{% endif %}">
      <a name="pagecontent" id="pagecontent"></a>

    </section>

  <div class="collection__header">
    <h1>{{ collection.title }}</h1>
  </div>
  {% if collection.description %}
    <div style="text-align:left;width:80%;margin:40px auto;">{{ collection.description }}</div>
  {% endif %}
  {% if collection.image %}
    <div class="container">
        <div class="one-whole column">
          <header class="banner center page-banner dark-overlay-{{ section.settings.image_darken }} full-width--{{ section.settings.wide_display }}">
            {%- assign image = collection.image -%}
            {% render 'image-element',
                  image: image,
                  alt: collection.title,
                  stretch_width: true,
                  progressive: true
            %}
          </header>
        </div>
      </div>
  {% endif %}
      <div class="breadcrumb-collection">
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "item": {
                    "@id": "{{ shop.url }}",
                    "name": "{{ 'general.breadcrumbs.home' | t }}"
                  }
                },
                {
                  "@type": "ListItem",
                  "position": 2,
                  "item": {
                    "@id": "{{ routes.collections_url }}/{% if collection.handle != blank %}{{ collection.handle }}{% else %}all{% endif %}",
                    "name": "{{ collection.title }}"
                  }
                }
                {% if current_tags %}
                  {% for tag in current_tags %}
                    {% unless tag contains 'meta-' %}
                      ,
                      {
                        "@type": "ListItem",
                        "position": {{ forloop.index | plus: 2 }},
                        "item": {
                          "@id": "{{ routes.collections_url }}/{% if collection.handle != blank %}{{ collection.handle }}{% else %}all{% endif %}/{{ tag | handleize }}",
                          "name": "{{ tag }}"
                        }
                      }
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              ]
            }
          </script>

          {% assign collection_breadcrumb_parents = collection.metafields.custom.collection_breadcrumb_parents.value %}
          {% assign collection_breadcrumb_size = collection_breadcrumb_parents.count %}

          {% if collection_breadcrumb_size > 0 %}
                <nav class="breadcrumbs breadcrumb_text custom">
                <a href="{{ routes.root_url }}">Home </a>›

                {% for root in collection_breadcrumb_parents %}
                    {% assign current = root %}
                    {% assign trail = '' %}
                    {% assign link = '<a href="' | append: current.url.value | append: '">' | append: current.title.value | append: '</a>' %}
                    {% assign trail = link | append: ' › ' | append: trail %}
                    {% assign current = current.parent.value %}
                    {{ trail }}
                {% endfor %}

                <span>{{ product.title }}</span>
                </nav>
          {% else %}
            <div class="breadcrumb_text native_breadcrumb">
                <a href="{{ routes.root_url }}" title="{{ shop.name | escape }}">
                <span>{{ 'general.breadcrumbs.home' | t }}</span>
                </a>

                <span class="breadcrumb-divider">/</span>

                <a href="{{ collection.url }}" title="{{ collection.title | escape }}" class="breadcrumb_link">
                <span>{{ collection.title }}</span>
                </a>

                {% if current_tags %}
                {% for tag in current_tags %}
                    {% unless tag contains 'meta-' %}
                    <span class="breadcrumb-divider">/</span>

                    <a href="{{ collection.url }}/{{ tag | handleize }}" title="{{ tag | escape }}">
                        <span>{{ tag }}</span>
                    </a>
                    {% endunless %}
                {% endfor %}
                {% endif %}
            </div>
           {% endif %}
      </div>
{% endif %}

