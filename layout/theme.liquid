    {% if template.name == 'collection' %}
      <script>
        window.onscroll = function() {scrollFunction()};
        
        function scrollFunction() {
           var someDiv = document.getElementById('snize_results');
           var distanceToTop = someDiv.getBoundingClientRect().top;
  		  
          if (distanceToTop <= 0) {
            document.getElementById("snize_results").classList.add("isSticky");
          } else {
            document.getElementById("snize_results").classList.remove("isSticky");
          }
        }
      </script>
      <style>
        @media only screen and (max-width: 992px) {
          .isSticky .snize-main-panel {
            position: sticky;
            top: 0;
            background-color:rgba(255, 255, 255, 1.0)!important;
            width:100vw;
            z-index:9999;
          }
        }
      </style>
    {% endif %}
    <script>
(function () {
  var STORE_DOMAIN = 'comet-kart-sales.myshopify.com'; // this site's Storefront domain
  var STORE_TOKEN = '2dac95e2495f5ebdf10ee78a5640474c'; // this site's Storefront Access Token

  function escapeHtml(s) {
    return (s || '').replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var cards = Array.prototype.slice.call(document.querySelectorAll('.dm-product-card[data-handle]'));
    if (!cards.length) return;

    var aliasMap = {};
    var queryParts = cards.map(function (card, i) {
      var alias = 'p' + i;
      aliasMap[alias] = card;
      var handle = card.getAttribute('data-handle').replace(/"/g, '');
      return alias + ': productByHandle(handle: "' + handle + '") { title featuredImage { url altText } priceRange { minVariantPrice { amount currencyCode } } }';
    });
    var query = 'query { ' + queryParts.join(' ') + ' }';

    fetch('https://' + STORE_DOMAIN + '/api/2024-01/graphql.json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': STORE_TOKEN
      },
      body: JSON.stringify({ query: query })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (!data.data) return;
      Object.keys(aliasMap).forEach(function (alias) {
        var product = data.data[alias];
        var card = aliasMap[alias];
        if (!product) return;

        var titleEl = card.querySelector('.dm-product-card__title');
        var imgWrap = card.querySelector('.dm-product-card__image');
        var priceEl = card.querySelector('.dm-product-card__price');

        if (titleEl && product.title) titleEl.textContent = product.title;
        if (imgWrap && product.featuredImage) {
          imgWrap.innerHTML = '<img src="' + product.featuredImage.url + '" alt="' + escapeHtml(product.featuredImage.altText) + '" />';
        }
        if (priceEl && product.priceRange && product.priceRange.minVariantPrice) {
          var amount = parseFloat(product.priceRange.minVariantPrice.amount).toFixed(2);
          priceEl.textContent = '$' + amount;
        }
      });
    })
    .catch(function () { /* fails silently — card stays blank rather than broken */ });
  });
})();
</script>
