      {% if template contains "index" %}{{ page_title }}{% else %}{{ page_title }} - Shop Karting Parts{% if current_tags %} {{ 'general.meta.tagged_html' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} {{ 'general.meta.page' | t: page_number: current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}{% endif %}
